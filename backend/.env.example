# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Persistence
DATABASE_URL=sqlite:///./data/rd_intelligence.db
DATABASE_ECHO=false

# OpenAI-compatible Chat Completions provider (required when MOCK_LLM=false).
# Structured calls require response_format={"type":"json_object"} support.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Set to 4.2 for a 15 RPM free-tier quota; leave 0 for unthrottled paid tiers.
LLM_MIN_REQUEST_INTERVAL_SECONDS=0

# Seconds to wait for one provider response. Raise it for a slower model, or
# one that reasons before answering: the analysis prompts ask for the largest
# structured output in the workflow and are the first to exceed a short wait.
LLM_REQUEST_TIMEOUT_SECONDS=30.0

# Optional: raises GitHub REST API rate limits for live research searches
GITHUB_TOKEN=

# Seconds between requests to one research source. arXiv asks for about three
# and enforces it by stalling replies until they time out; GitHub's
# unauthenticated search allows ten requests a minute, thirty with a token.
SOURCE_MIN_REQUEST_INTERVAL_SECONDS=3.0

# Offline-safe defaults. Keep MOCK_EXTERNAL_APIS=true with MOCK_LLM=false to
# run real model reasoning over frozen responses captured from arXiv/GitHub.
MOCK_LLM=true
MOCK_EXTERNAL_APIS=true
DEMO_MODE=false
