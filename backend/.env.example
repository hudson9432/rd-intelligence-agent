# =============================================================================
# This file runs OFFLINE as written: no API key, no network, nothing to set up.
# A mission goes end to end against responses captured earlier from the real
# arXiv and GitHub APIs. Only topics already captured return relevant sources.
#
# To go live, set both MOCK_ flags below to false and fill in the three
# provider fields. The values under them are not defaults anyone should keep:
# each one is annotated with what a live run measured against it.
# =============================================================================

# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Persistence
DATABASE_URL=sqlite:///./data/rd_intelligence.db
DATABASE_ECHO=false


# --- Mode -------------------------------------------------------------------
# true/true is offline and needs nothing else. Set both false to go live.
# MOCK_EXTERNAL_APIS=true with MOCK_LLM=false is the useful middle: real model
# reasoning over frozen sources, which keeps a demonstration reproducible.
MOCK_LLM=true
MOCK_EXTERNAL_APIS=true
DEMO_MODE=false


# --- Provider ---------------------------------------------------------------
# Required when MOCK_LLM=false; ignored otherwise.
# Any OpenAI-compatible Chat Completions endpoint. Structured calls require
# response_format={"type":"json_object"} support.
#
# Verified against:
#   https://generativelanguage.googleapis.com/v1beta/openai   gemini-3.1-flash-lite
#   https://api.gmi-serving.com/v1                            MiniMaxAI/MiniMax-M3
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Seconds to wait for one provider response.
# 30 is enough for a fast hosted model and far too short for one that reasons
# before answering: MiniMax-M3 regularly spends over a minute on the analysis
# prompts, which ask for the largest structured output in the workflow.
LLM_REQUEST_TIMEOUT_SECONDS=180.0

# Cap on one provider response.
# Leave blank and you inherit the provider's own default, often 4096, which the
# critique prompt exceeded in four of six measured attempts. The answer stops
# mid-token and is reported as truncated rather than as a contract failure, but
# the round is lost either way.
LLM_MAX_OUTPUT_TOKENS=8192

# Seconds between provider requests.
# Set this from the provider's quota, not from taste. Measured on GMI's free
# tier, 194 calls at roughly one second apart drew 13 rate-limit refusals; at
# four seconds the run cost 2.5 minutes of pacing instead of 6.5 minutes of
# penalties. 4.2 suits a 15 RPM quota. Leave 0 only on an unthrottled tier.
LLM_MIN_REQUEST_INTERVAL_SECONDS=4.0


# --- Research sources -------------------------------------------------------
# Optional, and worth setting for live retrieval. GitHub's unauthenticated
# search allows ten requests a minute; a token raises it to thirty. A full run
# issues around twelve, so an unauthenticated run will lose GitHub results in
# later rounds. The token needs no scopes: it only identifies you.
GITHUB_TOKEN=

# Seconds between requests to one research source.
# arXiv asks for about three and enforces it by stalling replies until they
# time out, which surfaces as a read timeout rather than as a refusal.
SOURCE_MIN_REQUEST_INTERVAL_SECONDS=3.0


# --- Run size ---------------------------------------------------------------
# The two levers on how long a mission takes. A measured full run: 30 minutes,
# 127 sources, 118 evidence cards, of which extraction was 52% of the clock and
# analysis another 32%.
#
# How many times the Critic may send the run back for more evidence. Each round
# costs a search, an extraction pass over everything it returns, and a full
# analysis. Set 1 for a demonstration someone is watching; 0 concludes from the
# first pass alone.
WORKFLOW_MAX_ITERATIONS=2

# How many results to keep from each source, for each query. Extraction runs
# one model call per retrieved source, so this multiplies out faster than it
# looks: four queries across two sources at eight results is up to 64 sources
# in a single round. 3 is a reasonable demonstration setting.
SEARCH_MAX_RESULTS_PER_SOURCE=8
