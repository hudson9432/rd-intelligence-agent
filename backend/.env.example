# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Persistence
DATABASE_URL=sqlite:///./data/rd_intelligence.db
DATABASE_ECHO=false

# OpenAI-compatible LLM provider (required only when MOCK_LLM=false)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional: raises GitHub REST API rate limits for live research searches
GITHUB_TOKEN=

# Offline-safe defaults; the end-to-end demo workflow is forthcoming
MOCK_LLM=true
MOCK_EXTERNAL_APIS=true
DEMO_MODE=false
